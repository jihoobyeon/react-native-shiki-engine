{
  "extends": "../../.config/typescript/tsconfig.expo.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/**/*.ts", "../shared/**/*.tsx"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "android", "ios"]
}

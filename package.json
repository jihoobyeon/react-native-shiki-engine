{
  "name": "react-native-shiki-engine-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "description": "Shiki syntax highlighting for React Native - Monorepo",
  "author": "Ryan Skinner <hello@ryanskinner.com> (https://github.com/skiniks)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "git submodule update --init --recursive packages/react-native-shiki-engine/third_party/oniguruma",
    "clean": "node scripts/clean.js",
    "update:submodule": "git submodule update --remote --merge",
    "build": "pnpm --filter react-native-shiki-engine build",
    "typecheck": "pnpm --filter react-native-shiki-engine build && pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "lint:cpp": "scripts/clang-format.sh",
    "lint:all": "pnpm lint:fix && pnpm lint:cpp",
    "dev": "pnpm -r --parallel run dev",
    "release": "pnpm --filter react-native-shiki-engine release"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@eslint-react/eslint-plugin": "catalog:eslint",
    "@release-it/conventional-changelog": "catalog:build",
    "eslint": "catalog:eslint",
    "eslint-plugin-oxlint": "catalog:eslint",
    "eslint-plugin-react-refresh": "catalog:eslint",
    "oxlint": "catalog:eslint",
    "release-it": "catalog:build",
    "typescript": "catalog:types"
  }
}
